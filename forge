#!/usr/bin/env sh
# Local launcher: installs only into this checkout's isolated environment.
set -eu
FORGE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$FORGE_ROOT/.venv/bin/forge" ]; then
  FORGE_PYTHON=${FORGE_PYTHON:-python3}
  "$FORGE_PYTHON" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else "Forge requires Python 3.12 or newer")'
  "$FORGE_PYTHON" -m venv "$FORGE_ROOT/.venv"
  "$FORGE_ROOT/.venv/bin/python" -m pip install "$FORGE_ROOT"
fi
if [ "$#" -eq 0 ]; then
  set -- init
fi
exec "$FORGE_ROOT/.venv/bin/forge" "$@"
